# Local development only. Use unique values and never commit a populated .env file.
SYNCAM_POSTGRES_ADMIN_PASSWORD=replace-admin-local-password
SYNCAM_POSTGRES_APP_PASSWORD=replace-app-local-password
SYNCAM_MIGRATION_DATABASE_URL=postgres://syncam_admin:replace-admin-local-password@localhost:5432/syncam?sslmode=disable
SYNCAM_DATABASE_URL=postgres://syncam_app:replace-app-local-password@localhost:5432/syncam?sslmode=disable
SYNCAM_WORKER_TENANT_ID=00000000-0000-4000-8000-000000000000
SYNCAM_RABBITMQ_PASSWORD=replace-for-local-development
# Set to `supabase` for the temporary MVP; omit or use `generic` for the
# existing provider-neutral/Cognito-compatible claim contract.
SYNCAM_OIDC_PROFILE=supabase
SYNCAM_OIDC_ISSUER=https://your-project-ref.supabase.co/auth/v1
SYNCAM_OIDC_AUDIENCE=authenticated
# Generate locally: 32 random bytes encoded with base64url. Never commit the real value.
SYNCAM_DEVICE_CLAIM_KEY=replace-with-base64url-encoded-32-byte-local-key
SYNCAM_HTTP_ADDR=:8080

# Web app data source. Demo mode needs no credentials or backend.
VITE_SYNCAM_DATA_MODE=demo
# Leave blank for same-origin production routing and the Vite local proxy.
VITE_SYNCAM_API_BASE_URL=
VITE_SYNCAM_TENANT_ID=00000000-0000-4000-8000-000000000000
VITE_SYNCAM_SITE_ID=00000000-0000-4000-8000-000000000000
# Safe for browser delivery: project URL and Supabase publishable (or legacy
# anon) key only. Never expose service-role keys, database passwords or tokens.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Never place an OIDC access token in an environment file. Live mode reads the
# short-lived token from sessionStorage key syncam.access_token.
