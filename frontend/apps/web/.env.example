# Copy to .env.local for local web development. The project URL and
# publishable key are public browser configuration, not credentials.
VITE_SYNCAM_DATA_MODE=demo
VITE_SYNCAM_API_BASE_URL=
VITE_SYNCAM_TENANT_ID=00000000-0000-4000-8000-000000000000
VITE_SYNCAM_SITE_ID=00000000-0000-4000-8000-000000000000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Never set service-role keys, database passwords, access tokens, or refresh
# tokens in a VITE_ variable or any committed environment file.
