{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.sentinelvision.ai/contracts/realtime-envelope-v1.schema.json",
  "title": "SyncCam AI realtime envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "seq", "ts"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "type": "string", "enum": ["event", "snapshot", "gap", "pong"] },
    "topic": { "type": "string", "enum": ["alerts.*", "alerts.created", "alerts.state"] },
    "seq": { "type": "integer", "minimum": 0 },
    "ts": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
